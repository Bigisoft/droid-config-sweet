[Unit]
Description=sweet: load the aw8624 haptic waveforms that lose the boot race with /vendor
# The driver requests aw8624_haptic.bin at ~7.9 s and gives up; vendor.mount is
# only active at ~8.6 s, so the firmware is never loaded and the haptic RAM stays
# uninitialised. Re-trigger it once /vendor actually exists. See the script for
# the full story - the symptom is haptics that buzz and feel too fast, not silence.
Requires=vendor.mount
After=vendor.mount
ConditionPathExists=/vendor/firmware/aw8624_haptic.bin

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/droid/sweet-haptic-fw-load.sh

[Install]
WantedBy=multi-user.target
