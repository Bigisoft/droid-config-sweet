[Unit]
Description=sweet: mixer wiring the 64-bit audio HAL cannot read from Xiaomi's overlay
Requires=droid-hal-init.service
After=droid-hal-init.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/droid/sweet-audio-mixer-defaults.sh

[Install]
WantedBy=multi-user.target