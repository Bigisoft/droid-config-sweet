[Unit]
Description=sweet: apply the Performance / Balanced / Battery saver mode
Documentation=file:///usr/bin/droid/sweet-performance-apply
After=mce.service systemd-tmpfiles-setup.service droid-hal-init.service
# Sailfish's system.conf allows only 3 starts in 180 s by default; a user
# trying the modes one after the other must never be dropped.
StartLimitIntervalSec=0

# Not started by multi-user.target directly: at boot it would run before the
# power HAL resets the CPU limits (see sweet-wait-for-power-hal).
# sweet-performance-boot.service starts it at the right moment, and
# sweet-performance.path whenever the mode changes.
[Service]
Type=oneshot
StateDirectory=sweet-performance-state
StateDirectoryMode=0700
# Returns at once after boot; only waits if a change comes in before the
# power HAL has finished starting.
ExecStartPre=/usr/bin/droid/sweet-wait-for-power-hal
ExecStart=/usr/bin/droid/sweet-performance-apply
TimeoutStartSec=180
